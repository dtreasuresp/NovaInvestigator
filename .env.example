# Copy this file to `.env.local` and fill in real values. Never commit real
# secrets. Variables prefixed with NEXT_PUBLIC_ are exposed to the browser;
# every other variable must stay server-side only.

# --- Supabase -----------------------------------------------------------
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public "publishable" (or legacy "anon") API key. Safe for the browser
# because Postgres RLS enforces access, never authorization by itself.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role key. Server-side only. Bypasses RLS. Never expose to the
# client, never prefix with NEXT_PUBLIC_, never log its value.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (see doc/plans/PLAN_MAESTRO_SUPABASE_BILLING_ACCESS_2026-08-07.md) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Keep false until Stripe Tax has an active registration for each jurisdiction.
STRIPE_TAX_ENABLED=false
# Optional comma-separated ISO 3166-1 alpha-2 codes. When set, Checkout
# restricts collected shipping countries to this allow-list.
ALLOWED_TAX_COUNTRIES=

# --- Application ----------------------------------------------------------
# Local development uses the same port as `pnpm dev` (for example,
# http://localhost:4101). Production must use the public HTTPS application
# origin, for example https://app.example.com.
NEXT_PUBLIC_APP_URL=

# --- Rate limits ------------------------------------------------------------
# All limits use RATE_LIMIT_WINDOW_SECONDS unless a feature documents another
# period. PDF exports are counted per tenant to protect the shared renderer.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ANONYMOUS_REQUESTS=30
RATE_LIMIT_AUTHENTICATED_REQUESTS=120
RATE_LIMIT_CHECKOUT_REQUESTS=5
RATE_LIMIT_PDF_REQUESTS=5

# --- Resend (server-side invitation delivery) ------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=

# --- External Research (§23 EXTERNAL_EVIDENCE) --------------------------------
# Tavily es preferido (search_depth advanced, credibility score). Brave es fallback.
# Si ninguno está configurado, web_research degrada explícitamente a EXTERNAL_RESEARCH_DISABLED sin inventar datos.
# Docs: https://docs.tavily.com  |  https://api.search.brave.com
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=
# BRAVE_API_KEY= # alias soportado

# --- AI Providers (OpenRouter $0 primario, luego Zen, luego resto) -----------
# OpenRouter — $0 50 req/día gratis sin tarjeta, 1.000 con $10, no entrena
# Crea key en https://openrouter.ai/keys  Docs: https://openrouter.ai/docs
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Free fallbacks :free (no tarjeta, 11-13 RPM) — se prueban tras gpt-4o-mini si falla; todos con tool-calling si soportan
# OPENROUTER_FREE_MODELS=meta-llama/llama-3.3-70b-instruct:free,qwen/qwen-3-coder:free,mistralai/mistral-small-3.2-24b-instruct:free,google/gemma-3-27b-it:free
# OpenCode Zen — host https://opencode.ai/zen/v1, gratis big-pickle (rotación 2 keys) + Muse/GPT si añades billing
# Crea key en https://opencode.ai/auth  Docs: https://opencode.ai/docs/zen
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_MODEL=big-pickle
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
# Fallbacks $0 sin tarjeta:
# GitHub Models — $0 con cuenta GitHub (temporalmente en brownout): https://github.com/settings/tokens
# GITHUB_TOKEN=
# Pollinations fallback sin key (best-effort): https://text.pollinations.ai — anónimo
# Cerebras opcional (requiere billing aunque sea tramo gratis): https://cloud.cerebras.ai/
# CEREBRAS_API_KEY=
# Groq fallback opcional (si reparas key): https://console.groq.com/keys — rápido y sin entrenamiento
# GROQ_API_KEY=
# Gemini en pausa hasta activar Tier 1 billing (evita limit:0 y entrenamiento en Free)
# Para reactivar: descomenta, pon AI_PROVIDER=gemini y vincula billing en https://aistudio.google.com
# GEMINI_API_KEY=

# --- i18n Translation Automation (Developer CLI Tooling) -------------------
# Reutiliza GEMINI_API_KEY para scripts/i18n-sync.ts
